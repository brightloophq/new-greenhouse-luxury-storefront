{
  "name": "new-greenhouse-luxury-storefront",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.4",
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "test": "vitest run",
    "flowers:optimize": "node scripts/optimize-flowers.mjs",
    "pages:optimize": "node scripts/optimize-pages.mjs",
    "images:audit": "node scripts/images/audit.mjs",
    "images:matrix": "node scripts/images/matrix.mjs",
    "images:pilot:dry-run": "node scripts/images/pilot.mjs",
    "images:pilot:generate": "node scripts/images/pilot.mjs --generate",
    "images:optimize": "node scripts/images/optimize.mjs",
    "images:integrate": "node scripts/images/integrate.mjs",
    "images:validate": "node scripts/images/validate.mjs",
    "images:flowers": "node scripts/images/flower-library.mjs",
    "video:hero": "node scripts/images/hero-video.mjs",
    "video:optimize": "node scripts/images/optimize-video.mjs",
    "shopify:collections": "node scripts/shopify/collections.mjs",
    "shopify:metafields": "node scripts/shopify/metafields.mjs",
    "shopify:tags": "node scripts/shopify/tags.mjs",
    "shopify:varieties": "node scripts/shopify/varieties.mjs",
    "shopify:setup": "npm run shopify:collections && npm run shopify:metafields && npm run shopify:tags && npm run shopify:varieties",
    "video:poster": "node scripts/images/hero-poster.mjs"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@shopify/hydrogen": "2026.4.4",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "gsap": "^3.15.0",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "3.93.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.0",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "prettier": "^3.4.2",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ]
}
